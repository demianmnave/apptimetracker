# App Time Tracker - Environment Configuration Template
# Copy this file to .env and adjust values for your environment

# Database Configuration
DB_PATH=C:\ProgramData\AppTimeTracker\apptracker.db
CONNECTION_STRING=Data Source=%ProgramData%\AppTimeTracker\apptracker.db

# Logging Configuration
LOG_PATH=C:\ProgramData\AppTimeTracker\Logs
LOG_LEVEL=Information
LOG_FILE_SIZE_BYTES=10000000
LOG_RETAINED_FILE_COUNT=5
LOG_EVENT_LOG_FALLBACK_ENABLED=true

# Service Configuration
SERVICE_NAME=AppTimeTracker
SERVICE_DISPLAY_NAME=App Time Tracker
POLLING_INTERVAL_MS=500
SESSION_FLUSH_INTERVAL_MS=30000
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30

# Session Monitoring Configuration
SESSION_MONITORING_ENABLED=true
PAUSE_ON_LOCK=true

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=60
MEMORY_THRESHOLD_MB=100
HEALTH_CHECK_RETRY_COUNT=3
HEALTH_CHECK_BACKOFF_MULTIPLIER=2.0
HEALTH_CHECK_INITIAL_BACKOFF_MS=100
AUTO_RECOVERY_ENABLED=true

# Environment
ENVIRONMENT=Production
ASPNETCORE_ENVIRONMENT=Production

# Optional: Sentry/Error Aggregation (if enabled in future)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Optional: Seq Logging (if enabled for centralized logging)
# SEQ_SERVER_URL=http://localhost:5341
# SEQ_API_KEY=your-api-key
