<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-AppTimeTracker-0c13e346-4e6b-4bf5-a19b-959c52191eb6</UserSecretsId>
    <RootNamespace>AppTimeTracker</RootNamespace>
    <AssemblyName>AppTimeTracker</AssemblyName>
